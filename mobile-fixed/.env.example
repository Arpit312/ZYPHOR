# ZYPHOR Mobile App (Expo) — environment variables
# Copy to .env and fill REAL values. Never commit .env (it is gitignored).
# EXPO_PUBLIC_* vars are inlined into the app bundle at build time.

# Backend API base URL — MUST include the /api suffix (calls are made as "/auth/login" etc.)
# Dev with backend on this machine: http://localhost:5000/api (Android emulator: http://10.0.2.2:5000/api)
# Dev with a physical phone on the same WiFi: use this machine's LAN IP, e.g. http://192.168.1.10:5000/api
# For EAS production builds use your deployed backend URL, e.g. https://api.zyphor.in/api
EXPO_PUBLIC_API_URL=http://localhost:5000/api
