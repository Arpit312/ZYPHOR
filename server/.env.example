# ZYPHOR Mobile Backend — environment variables
# Copy to .env and fill REAL values. Never commit .env (it is gitignored).

# Required: MongoDB Atlas connection string (shared with the website for cross-platform login)
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
MONGODB_URI=

# Required: JWT signing secret — MUST be the SAME value as the website backend so tokens work cross-platform
JWT_SECRET=

# Server
PORT=5000
NODE_ENV=development
# Comma-separated allowed origins (mobile app sends no Origin header, which is allowed)
# ALLOWED_ORIGINS=http://localhost:3000,https://zyphor.vercel.app

# Gemini AI (advisor / pricing / IMEI verification). Without a key, /api/ai/* returns 503
# and /api/ai/verify-imei falls back to an honest local Luhn check (localOnly: true).
GEMINI_API_KEY=

# Cloudinary (image uploads). Without creds, uploads fall back to local /public/uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay (subscription payments). Production REQUIRES a configured gateway and a
# verified payment signature before a subscription is activated.
# In development without these keys, subscriptions activate directly (devActivated: true).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: email/SMS provider for sending the password-reset OTP.
# In development (NODE_ENV != production) the OTP is returned in the API response as devCode.
# EMAIL_FROM=noreply@zyphor.in
